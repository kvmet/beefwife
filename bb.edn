{:paths ["bb"]
 :tasks
 {descriptor
  {:doc "Check the Beefwife descriptor schema."
   :task (do
           (shell "node" "test/beefwife/descriptor.test.js")
           (shell "node" "test/beefwife/schema.test.js"))}

  beefwife-model
  {:doc "Check descriptor compilation and model contracts."
   :task (shell "node" "test/beefwife/model.test.js")}

  beefwife-api
  {:doc "Check the public Beefwife lifecycle."
   :task (shell "node" "test/beefwife/api.test.js")}

  canvas-runtime
  {:doc "Check BeefwifeCanvas routing and runtime integration."
   :task (do
           (shell "node" "test/beefwife-canvas/routing.test.js")
           (shell "node" "test/beefwife-canvas/runtime.test.js"))}

  beefwife-build
  {:doc "Build standalone Beefwife browser artifacts."
   :task (shell "npm" "--prefix" "beefwife" "run" "build")}

  beefwife-package
  {:doc "Build and check the published Beefwife package."
   :depends [beefwife-build]
   :task (shell "node" "test/beefwife/package.test.mjs")}

  terrain-build
  {:doc "Build standalone Terrain browser artifacts."
   :task (shell "npm" "--prefix" "terrain" "run" "build")}

  terrain
  {:doc "Build and check the Terrain public API and routing."
   :depends [terrain-build]
   :task (do
           (shell "npm" "--prefix" "terrain" "test")
           (shell "node" "test/terrain/package.test.mjs"))}

  terrain-benchmark
  {:doc "Benchmark Terrain's cached query operations."
   :depends [terrain-build]
   :task (shell "npm" "--prefix" "terrain" "run" "benchmark")}

  canvas
  {:doc "Check the BeefwifeCanvas public boundary."
   :task (shell "node" "test/beefwife-canvas/canvas.test.js")}

  canvas-build
  {:doc "Build the standalone BeefwifeCanvas browser bundle."
   :task (shell "npm" "--prefix" "beefwife-canvas" "run" "build")}

  canvas-package
  {:doc "Build and check the published BeefwifeCanvas package."
   :depends [canvas-build]
   :task (do
           (shell "node" "test/beefwife-canvas/bundle.test.js")
           (shell "node" "test/beefwife-canvas/package.test.mjs"))}

  test
  {:doc "Run the complete headless library test suite."
   :depends [canvas-build]
   :task (shell "node" "test/run.js")}

  test-lab
  {:doc "Check and build Beefwife Lab."
   :task (shell "npm" "--prefix" "beefwife-lab" "run" "check")}

  format-cast
  {:doc "Rewrite the example and cast fixtures in canonical schema form."
   :task (shell "node" "bb/format-cast.js")}

  kipple
  {:doc "Run repository hygiene checks."
   :task (load-file "bb/kipple.clj")}}}
